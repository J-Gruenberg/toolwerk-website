{
 "framework": null,
 "outputDirectory": "site",
 "cleanUrls": true,
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/:path*",
   "has": [
    {
     "type": "host",
     "value": "angebote-in-minuten.de"
    }
   ],
   "destination": "https://www.tool-werk.de/angebote-kalkulieren",
   "permanent": true
  },
  {
   "source": "/:path*",
   "has": [
    {
     "type": "host",
     "value": "www.angebote-in-minuten.de"
    }
   ],
   "destination": "https://www.tool-werk.de/angebote-kalkulieren",
   "permanent": true
  },
  {
   "source": "/aim",
   "destination": "/angebote-kalkulieren",
   "permanent": true
  },
  {
   "source": "/aim/:path*",
   "destination": "/angebote-kalkulieren",
   "permanent": true
  },
  {
   "source": "/index",
   "destination": "/",
   "permanent": true
  },
  {
   "source": "/leistungen",
   "destination": "/digitale-mitarbeiter",
   "permanent": false
  },
  {
   "source": "/kontakt",
   "destination": "/#check",
   "permanent": false
  }
 ],
 "headers": [
  {
   "source": "/assets/fonts/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/assets/(css|js)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/assets/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  },
  {
   "source": "/og/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400"
    }
   ]
  }
 ]
}