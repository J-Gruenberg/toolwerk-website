{
 "framework": null,
 "outputDirectory": "site",
 "cleanUrls": true,
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/aim",
   "destination": "/",
   "permanent": false
  },
  {
   "source": "/aim/:path*",
   "destination": "/",
   "permanent": false
  },
  {
   "source": "/index",
   "destination": "/",
   "permanent": true
  }
 ],
 "headers": [
  {
   "source": "/assets/fonts/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/assets/(css|js)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/assets/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  }
 ]
}